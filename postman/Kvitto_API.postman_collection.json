{
  "info": {
    "_postman_id": "f7cfab7f-b706-4dae-9f7d-f905806f22f4",
    "name": "Квитто — Тестирование API оплаты (QA Assignment)",
    "description": "Официальная коллекция тестов для проверки API платежной страницы https://kvitto-qa-demo.vercel.app/api.\nПокрывает все 3 эндпоинта (позитивные и негативные сценарии) с валидацией статус-кодов, схемы ответа и бизнес-правил через pm.test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /api/tariffs (Позитивный) — Получение списка тарифов",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tariffs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tariffs"
          ]
        },
        "description": "Проверка получения списка тарифов: basic (9900 ₽), standard (19900 ₽), premium (29900 ₽)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Заголовок ответа Content-Type: application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Тело ответа — массив тарифов из 3 элементов\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\").with.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Присутствуют обязательные идентификаторы: basic, standard, premium\", function () {",
              "    const ids = pm.response.json().map(t => t.id);",
              "    pm.expect(ids).to.have.members([\"basic\", \"standard\", \"premium\"]);",
              "});",
              "",
              "pm.test(\"Цены тарифов строго соответствуют ТЗ (9900, 19900, 29900)\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.find(t => t.id === 'basic').price).to.eql(9900);",
              "    pm.expect(data.find(t => t.id === 'standard').price).to.eql(19900);",
              "    pm.expect(data.find(t => t.id === 'premium').price).to.eql(29900);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST /api/payments (Позитивный) — Создание платежа (Стандарт, Карта)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tariff_id\": \"standard\",\n    \"name\": \"Иван Иванов\",\n    \"email\": \"ivan.ivanov@example.com\",\n    \"phone\": \"+7 999 123-45-67\",\n    \"method\": \"card\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Создание стандартного платежа картой без промокода."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Платёж создан — статус 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Заголовок Content-Type: application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Тело ответа соответствует контракту платежа (status pending, amount 19900, RUB)\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"id\").that.is.a(\"string\");",
              "    pm.expect(res.status).to.eql(\"pending\");",
              "    pm.expect(res.tariff_id).to.eql(\"standard\");",
              "    pm.expect(res.amount).to.eql(19900);",
              "    pm.expect(res.currency).to.eql(\"RUB\");",
              "    pm.expect(res.method).to.eql(\"card\");",
              "    pm.expect(res.email).to.eql(\"ivan.ivanov@example.com\");",
              "});",
              "",
              "pm.test(\"Сохранение payment_id в переменные окружения\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.id).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"payment_id\", res.id);",
              "});",
              "    if (typeof res !== \"undefined\" && typeof res.amount !== \"undefined\") {",
              "        pm.expect(Number.isInteger(res.amount), \"Поле amount должно быть целым числом (integer)\").to.be.true;",
              "    }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. POST /api/payments (Позитивный) — Применение промокода KVITTO10 (-10%)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tariff_id\": \"standard\",\n    \"name\": \"Петр Петров\",\n    \"email\": \"petr@example.com\",\n    \"phone\": \"+7 999 765-43-21\",\n    \"method\": \"card\",\n    \"promo_code\": \"KVITTO10\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Проверка расчета скидки 10% на сервере: 19900 - 10% = 17910 ₽."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Платёж создан — статус 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Сумма учитывает промокод (19900 - 10% = 17910 ₽)\", function () {",
              "    pm.expect(pm.response.json().amount).to.eql(17910);",
              "});",
              "    if (typeof res !== \"undefined\" && typeof res.amount !== \"undefined\") {",
              "        pm.expect(Number.isInteger(res.amount), \"Поле amount должно быть целым числом (integer)\").to.be.true;",
              "    }"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST /api/payments (Позитивный) — Чек на другой email",
