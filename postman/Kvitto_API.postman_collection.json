          "raw": "{\n    \"tariff_id\": \"standard\",\n    \"name\": \"Анна Сидорова\",\n    \"email\": \"main@example.com\",\n    \"phone\": \"+7 999 000-11-22\",\n    \"method\": \"sbp\",\n    \"receipt_email\": \"accounting@company.ru\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
