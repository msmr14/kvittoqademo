            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Проверка сохранения альтернативного email для чека (receipt_email)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Платёж создан — статус 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"receipt_email сохранён в ответе сервера без перезаписи\", function () {",
