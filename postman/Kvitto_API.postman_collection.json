              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. POST /api/payments (Позитивный) — Рассрочка 0% на 6 месяцев",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tariff_id\": \"basic\",\n    \"name\": \"Ольга Васильева\",\n    \"email\": \"olga@example.com\",\n    \"phone\": \"+7 911 222-33-44\",\n    \"method\": \"installment\",\n    \"installment_months\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Создание платежа в рассрочку с валидным сроком 6 месяцев."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Платёж создан — статус 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Параметры рассрочки сохранены корректно (method: installment, months: 6)\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.method).to.eql(\"installment\");",
              "    pm.expect(res.installment_months).to.eql(6);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. POST /api/payments (Негативный) — Валидация обязательных полей",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"method\": \"card\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Проверка возврата ошибки валидации 422 при отсутствии обязательных полей."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 422 Unprocessable Entity\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test(\"Структура ответа содержит error: 'validation_error' и словарь fields\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.error).to.eql(\"validation_error\");",
              "    pm.expect(res.fields).to.be.an(\"object\");",
              "    pm.expect(res.fields).to.have.property(\"name\");",
              "    pm.expect(res.fields).to.have.property(\"email\");",
              "    pm.expect(res.fields).to.have.property(\"tariff_id\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. POST /api/payments (Негативный) — Невалидный срок рассрочки (5 месяцев)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tariff_id\": \"standard\",\n    \"name\": \"Тест Тестов\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"+7 999 555-66-77\",\n    \"method\": \"installment\",\n    \"installment_months\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Проверка отклонения невалидного срока рассрочки (допустимы только 3, 6, 12)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 422 Unprocessable Entity\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test(\"Ошибка содержит поле installment_months\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.fields).to.have.property(\"installment_months\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. GET /api/payments/{{payment_id}} (Позитивный) — Получение платежа по ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/payments/{{payment_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments",
            "{{payment_id}}"
          ]
        },
        "description": "Получение информации о ранее созданном платеже по его ID из переменной окружения."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"ID платежа совпадает с запрошенным\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.id).to.eql(pm.environment.get(\"payment_id\"));",
              "});",
              "",
              "pm.test(\"Сумма и метод соответствуют созданному платежу\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.amount).to.eql(19900);",
              "    pm.expect(res.method).to.eql(\"card\");",
              "    pm.expect(res.status).to.eql(\"pending\");",
              "});",
              "    if (typeof res !== \"undefined\" && typeof res.amount !== \"undefined\") {",
              "        pm.expect(Number.isInteger(res.amount), \"Поле amount должно быть целым числом (integer)\").to.be.true;",
              "    }"
            ]
          }
        }
      ]
    },
    {
      "name": "9. GET /api/payments/non_existent_id_99999 (Негативный) — Запрос несуществующего платежа",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/payments/non_existent_id_99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments",
            "non_existent_id_99999"
          ]
        },
        "description": "Проверка возврата ошибки 404 { error: 'not_found' } для несуществующего ID платежа."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Тело ответа содержит ошибку { error: 'not_found' }\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.deep.eql({ error: \"not_found\" });",
              "});"
            ]
          }
        }
      ]
    }
